<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/assets/og.png">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css">
  <script>
    // Before first paint: honor a chosen theme; otherwise the system decides.
    (function () {
      var t = localStorage.getItem('palana-theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    })();
  </script>
</head>
<body>
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true"><defs>
    <g id="palana-leaf">
      <path id="palana-p-path" fill="currentColor" d="M378.65,89.8c77.78,66.39,7.45,192.67-88.92,185.28-5.17-.4-14.71-3.69-18.92-2.96-2.55.44-10.86,5.66-15.01,7-9.83,3.19-24.27,4.85-34.02,1.01-16.02-6.31.93-18.04,10.26-19.78,6.67-1.24,15.02.71,21.67-.3,14.92-2.25,35.14-27.68,40.97-40.9,4.78-10.83,9.18-28.89,1.04-38.94-9.65-11.91-23.8-5.24-34.39,1.59-42.94,27.68-71.25,120.46-86.21,168.37-3.5,11.2-4.94,22.73-10.89,33.04-8.44,14.64-25.86,26.86-42.71,29.18l-1.76-2.01c5.13-9.03,7.96-19.16,10.46-29.23,21.59-87.12,32.01-222.47,104.07-283.3,41.74-35.23,100.32-45.63,144.35-8.06ZM323.16,173.26v-15.48c0-3.48,3.37-12.43,5.13-15.83,7.09-13.67,22.99-20.83,36.79-25.61-2.02-8.85-12.85-17.3-20.66-21.76-28.49-16.27-61.13-12.65-87.47,5.98-44.97,31.8-55.98,111.1-65.83,161.81-1.31,6.73-3.38,13.46-4.75,20.2l2,2.52c-.14-1.73-.07-3.29.56-4.94,15.2-40.18,37.54-93.27,78.11-113.58,14.29-7.15,35.96-12.4,48.77.07,2.34,2.27,3.23,7.39,7.34,6.63ZM288.72,265.11h15.97c5.31,0,20.66-5.49,26.12-7.82,45.88-19.59,68.16-82.77,44.97-127.18-.75-1.44-9.07-14.74-10.69-12.76-2.68,18.09-1.77,40.16-17.94,52.46-5.8,4.41-13.86,4.8-17.65,11.3-4.02,6.9-1.74,13.17-2.37,20.59-1.95,22.93-21.14,48.33-39.43,61.42l1.01,2Z"/>
      <line x1="328.92" y1="172.46" x2="341.85" y2="149.19" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
      <!-- the leaf blade, solid accent green—the counters stay open, but the leaf itself never goes transparent over imagery -->
      <clipPath id="palana-leaf-blade"><ellipse cx="335" cy="146" rx="40" ry="23" transform="rotate(-60 335 146)"/><circle cx="350" cy="120" r="10"/></clipPath>
      <g clip-path="url(#palana-leaf-blade)" style="color: var(--accent);"><use href="#palana-p-path"/></g>
    </g>
  </defs></svg>
  {%- set navitems = [
    { url: "/help/", label: "help" },
    { url: "/the-plan/", label: "the plan" },
    { url: "/keys/", label: "keys" },
    { url: "/faq/", label: "faq" }
  ] %}
  <header class="site-head{% if wide %} wide{% endif %}">
    <div class="row">
      <a class="wm-lockup" href="/" aria-label="pālana home">
        <svg viewBox="115 60 302 356" aria-hidden="true"><use href="#palana-leaf"/></svg>
        <span class="wm-rest" aria-hidden="true">alana</span>
        <span class="wm-bar" aria-hidden="true"></span>
      </a>
      <nav class="site-nav">
        {%- for item in navitems %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
        <a href="https://github.com/sageframe-no-kaji/palana">github</a>
      </nav>
      <button class="theme-toggle" id="theme-toggle" aria-label="switch appearance">system</button>
      <details class="nav-pocket">
        <summary aria-label="menu">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav class="pocket-links">
          {%- for item in navitems %}
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- endfor %}
          <a href="https://github.com/sageframe-no-kaji/palana">github</a>
        </nav>
      </details>
    </div>
  </header>
  <main{% if wide %} class="wide"{% endif %}>
    {{ content | safe }}
  </main>
  <footer class="site-foot">
    <div class="row">
      <strong>pālana</strong> (पालन)—Sanskrit: to tend, to sustain.
      A <a href="https://atmarcus.net">Sageframe</a> project by Andrew Marcus,
      built in public with the <a href="https://github.com/sageframe-no-kaji/ho-system">Ho System</a>.
      Open source under <a href="https://www.gnu.org/licenses/gpl-3.0.html">GPL-3.0</a>.
    </div>
  </footer>
  <script>
    // The app's appearance setting, echoed: system → light → dark → system.
    (function () {
      var button = document.getElementById('theme-toggle');
      var order = ['system', 'light', 'dark'];
      var current = localStorage.getItem('palana-theme') || 'system';
      button.textContent = current;
      button.addEventListener('click', function () {
        current = order[(order.indexOf(current) + 1) % order.length];
        if (current === 'system') {
          localStorage.removeItem('palana-theme');
          delete document.documentElement.dataset.theme;
        } else {
          localStorage.setItem('palana-theme', current);
          document.documentElement.dataset.theme = current;
        }
        button.textContent = current;
      });
    })();
  </script>
</body>
</html>
